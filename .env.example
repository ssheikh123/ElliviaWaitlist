# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# Everything prefixed with VITE_ is PUBLIC: it is bundled into the website.
# Never put a secret key (sb_secret_..., Turnstile secret) in this file.

# Your Supabase project URL
VITE_SUPABASE_URL=https://rjmtferugizqsxaqxkds.supabase.co

# Supabase publishable key (starts with sb_publishable_). Safe for browsers.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Waitlist Edge Function endpoint
VITE_WAITLIST_FUNCTION_URL=https://rjmtferugizqsxaqxkds.supabase.co/functions/v1/join-waitlist

# Cloudflare Turnstile PUBLIC site key (starts with 0x...).
# For local UI work you can use Cloudflare's test key 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=0xREPLACE_ME

# Optional: public contact address shown in the footer & privacy policy
VITE_CONTACT_EMAIL=ellivia.org@gmail.com
