# Local-only secrets for `supabase functions serve --env-file supabase/functions/.env`.
# Copy to supabase/functions/.env (git-ignored). In production, set these under
# Supabase Dashboard -> Edge Functions -> Secrets instead.
# Cloudflare's dummy secret that always passes (pair with site key 1x00000000000000000000AA):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_ORIGINS=http://localhost:5173
